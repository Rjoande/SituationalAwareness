<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- KSP 1.12.5 runs Unity 2019.4 / Mono: target .NET Framework 4.7.2 -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>SituationalAwareness</AssemblyName>
    <RootNamespace>SituationalAwareness</RootNamespace>
    <Version>0.2.1</Version>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against reference assemblies even without a local targeting pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\KSP_x64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\KSP_x64_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\KSP_x64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\KSP_x64_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\KSP_x64_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\KSP_x64_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\KSP_x64_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ToolbarControl">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\GameData\001_ToolbarControl\Plugins\ToolbarControl.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- EVE volumetric clouds: SOFT dependency for the WEATHER row. Every type
         from these two lives inside EveWeatherReader alone, which is only ever
         entered after WeatherClassifier.Available confirms both assemblies are
         loaded — so on an install without EVE the reference is never resolved
         and nothing throws (same pattern already proven in game by the survey
         companion, notes/indagine-meteo.md §6). Private=false: never copied
         into the release. -->
    <Reference Include="Atmosphere">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\GameData\EnvironmentalVisualEnhancements\Plugins\Atmosphere.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EVEManager">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\GameData\EnvironmentalVisualEnhancements\Plugins\EVEManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy the plugin DLL into the mod folder KSP actually loads. Path
       updated for the double-root reorg (publication prep): the installable
       mod now lives at GameData/SituationalAwareness/GameData/SituationalAwareness/,
       matching the layout of GameData/KRAB, GameData/KRILL, GameData/TimeForScience. -->
  <Target Name="DeployToGameData" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\GameData\SituationalAwareness\Plugins\" />
  </Target>

</Project>
