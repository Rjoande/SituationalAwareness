<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- KSP 1.12.5 runs Unity 2019.4 / Mono: target .NET Framework 4.7.2 -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>SaWeatherReport</AssemblyName>
    <RootNamespace>SituationalAwareness.WeatherReport</RootNamespace>
    <Version>0.2.4</Version>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- KSP install the reference assemblies come from. Defaults to the game
         root three levels up (the repo living in <KSP>/GameData/SituationalAwareness);
         when the repo lives elsewhere, pass it explicitly (2026-09-18):
             dotnet build -c Release -p:KspRoot="E:\games\KSP" -->
    <KspRoot Condition="'$(KspRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..</KspRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against reference assemblies even without a local targeting pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SA's own extension point (SaExtensionPoint) — the only public
         surface this companion touches, not copied into our own Plugins/
         folder (already present in SA's, would just be a stale duplicate). -->
    <Reference Include="SituationalAwareness">
      <HintPath>$(MSBuildProjectDirectory)\..\GameData\SituationalAwareness\Plugins\SituationalAwareness.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- EVE Volumetrics: compile-time reference (same pattern as
         ToolbarControl elsewhere), guarded at runtime by an
         AssemblyLoader.loadedAssemblies check before touching these types
         (notes/indagine-meteo.md §6) — players without EVE installed must
         never hit a missing-assembly crash. -->
    <Reference Include="Atmosphere">
      <HintPath>$(KspRoot)\GameData\EnvironmentalVisualEnhancements\Plugins\Atmosphere.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EVEManager">
      <HintPath>$(KspRoot)\GameData\EnvironmentalVisualEnhancements\Plugins\EVEManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy into SA's own installed mod folder, next to
       SituationalAwareness.dll — deliberate choice (2026-08-17): one
       GameData folder for the player to manage, uninstalling the
       companion is just deleting this one DLL. -->
  <Target Name="DeployToGameData" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\GameData\SituationalAwareness\Plugins\" />
  </Target>

</Project>
